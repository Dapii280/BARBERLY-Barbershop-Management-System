PORT=5000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=barberly

# Aktifkan jika memakai database cloud (Aiven) yang mewajibkan SSL
DB_SSL=false

JWT_SECRET=ganti_dengan_secret_acak_yang_panjang
JWT_EXPIRES_IN=7d

# Tarif PPN dan potongan biaya administrasi/promosi usaha
PPN_RATE=0.11
TAX_DEDUCTION_RATE=0.02

# URL publik backend, dipakai saat Cloudinary tidak dikonfigurasi
APP_BASE_URL=http://localhost:5000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
